# Copy this file to .env (same directory) and adjust values as needed.
# .env is gitignored; .env.example is committed as a template only.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# pgAdmin (web GUI at http://localhost:5050 once running)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=changeme
PGADMIN_PORT=5050

# "Continue with Google" (see the root README). Leave empty to keep it disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only needed for a public address; local default is http://localhost:8000/api/auth/google/callback
GOOGLE_REDIRECT_URI=
